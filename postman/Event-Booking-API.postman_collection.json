              "raw": "{\n  \"title\": \"Jazz Night\",\n  \"description\": \"Live jazz band performance\",\n  \"venue\": \"Blue Note Club\",\n  \"startTime\": \"2026-08-15T19:00:00.000Z\",\n  \"endTime\": \"2026-08-15T22:00:00.000Z\",\n  \"totalTickets\": 80,\n  \"pricePerTicket\": 45.5\n}"

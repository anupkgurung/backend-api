              "raw": "{\n  \"title\": \"Should Fail\",\n  \"description\": \"RBAC demo\",\n  \"venue\": \"Nowhere\",\n  \"startTime\": \"2026-09-01T18:00:00.000Z\",\n  \"endTime\": \"2026-09-01T21:00:00.000Z\",\n  \"totalTickets\": 10,\n  \"pricePerTicket\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]

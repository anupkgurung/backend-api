    {
      "name": "Demo Flow",
      "item": [
        {
          "name": "1. Login Organizer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('organizerToken', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "2. Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
